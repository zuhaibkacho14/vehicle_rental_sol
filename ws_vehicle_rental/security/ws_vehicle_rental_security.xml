<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ws_vehicle_rental_user" model="res.groups">
        <field name="name">Vehicle Rental / User</field>
        <field name="category_id" ref="base.module_category_services_fleet"/>
    </record>

    <record id="group_ws_vehicle_rental_manager" model="res.groups">
        <field name="name">Vehicle Rental / Manager</field>
        <field name="category_id" ref="base.module_category_services_fleet"/>
        <field name="implied_ids" eval="[(4, ref('group_ws_vehicle_rental_user'))]"/>
    </record>

    <record id="group_ws_vehicle_rental_admin" model="res.groups">
        <field name="name">Vehicle Rental / Administrator</field>
        <field name="category_id" ref="base.module_category_services_fleet"/>
        <field name="implied_ids" eval="[(4, ref('group_ws_vehicle_rental_manager'))]"/>
    </record>
</odoo>
