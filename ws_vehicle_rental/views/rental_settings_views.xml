<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ws_vehicle_rental_config_tree" model="ir.ui.view">
        <field name="name">ws.vehicle.rental.config.tree</field>
        <field name="model">ws.vehicle.rental.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="default_daily_rate"/>
                <field name="default_weekly_rate"/>
                <field name="default_monthly_rate"/>
            </tree>
        </field>
    </record>

    <record id="view_ws_vehicle_rental_config_form" model="ir.ui.view">
        <field name="name">ws.vehicle.rental.config.form</field>
        <field name="model">ws.vehicle.rental.config</field>
        <field name="arch" type="xml">
            <form string="Rental Settings">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="default_daily_rate"/>
                        <field name="default_weekly_rate"/>
                        <field name="default_monthly_rate"/>
                    </group>
                    <group>
                        <field name="allow_public_booking"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
